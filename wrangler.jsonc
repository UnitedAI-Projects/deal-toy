{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unitedai-deal-toy",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deal-toy",
      "database_id": "01262ea9-4640-464f-870c-2c7618f5fb5a",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "deal-toy-artifacts",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "BUILDS",
        "queue": "deal-toy-builds",
      },
    ],
    "consumers": [
      {
        "queue": "deal-toy-builds",
        "max_batch_size": 1,
        "max_concurrency": 2,
        "max_retries": 1,
      },
    ],
  },
  "containers": [
    {
      "class_name": "CadContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "cad": {
          "dockerfile": "./engine/Dockerfile",
          "build_context": ".",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CAD",
        "class_name": "CadContainer",
      },
      {
        "name": "LIVE",
        "class_name": "ProjectLive",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CadContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProjectLive"],
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://snowy-voice-36a1.cloudflareaccess.com",
    "ACCESS_AUD": "d92a3553a93773fddbed204b4a6ff3c69636e03aa984938460adadc00f113903",
    "RELEASE_SHA": "development",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true,
    },
  ],
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  MantelCAD MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build mantelcad.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc mantelcad.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\MantelCAD by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  MantelCAD" box. Installs a Start Menu shortcut, mantelcad-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), offers MantelCAD for compatible design files under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- MantelCAD has a distinct UpgradeCode; retain it for future MantelCAD upgrades. -->
  <Package
      Name="MantelCAD"
      Manufacturer="Ivan Chen"
      Version="$(var.Version)"
      UpgradeCode="63A351AA-B8B7-5BAE-BE03-12CD5D8CF2D8"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="MantelCAD parametric 3D CAD" Manufacturer="Ivan Chen" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MantelCAD is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="MantelCADIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MantelCADIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ichen27/mantelcad/tree/main/docs/book/src/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ichen27/mantelcad/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ichen27/mantelcad/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MantelCAD" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by MantelCADApp). -->
    <!-- Settings and the installation directory belong to MantelCAD. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\MantelCAD" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="MantelCAD" Level="1">
      <ComponentGroupRef Id="MantelCADFiles" />
    </Feature>

    <!-- The installer includes the applicable licence files in its destination directory. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchMantelCAD"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="MantelCADVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="MantelCAD $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch MantelCAD" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MantelCADExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchMantelCAD" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="MantelCADFiles" Directory="INSTALLFOLDER">
      <!-- MantelCAD component identity is independent of the upstream application. -->
      <Component Id="MantelCADApp" Guid="5D691C52-08D0-5787-8F83-D3EC357A83EE">
        <File Id="MantelCADExe" Source="$(var.BinDir)\mantelcad.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MantelCAD"
              Description="MantelCAD parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="MantelCADIcon.exe" IconIndex="0" />
        </File>

        <!-- Compatible designs: offer MantelCAD without changing another app's default. -->
        <ProgId Id="MantelCAD.Design" Description="MantelCAD Design" Icon="MantelCADExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MantelCAD.Design\shell\open\command" Value="&quot;[#MantelCADExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.sc\OpenWithProgids" Name="MantelCAD.Design" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft\OpenWithProgids" Name="MantelCAD.Design" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft\OpenWithProgids" Name="MantelCAD.Design" Value="" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="MantelCAD.Model" Description="3D model" Icon="MantelCADExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MantelCAD.Model\shell\open\command" Value="&quot;[#MantelCADExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="MantelCAD.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="MantelCAD.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="MantelCAD.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="MantelCAD.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="MantelCAD.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="MantelCAD.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "mantelcad"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe" Name="FriendlyAppName" Value="MantelCAD" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\shell\open\command" Value="&quot;[#MantelCADExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".solidcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\mantelcad.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\mantelcad.exe" Value="[#MantelCADExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\MantelCAD" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="MantelCADCli">
        <File Id="MantelCADCliExe" Source="$(var.BinDir)\mantelcad-cli.exe" KeyPath="yes" />
        <!-- The install folder on the system PATH, so MCP clients and shells find `mantelcad-cli` by name;
             removed again on uninstall. -->
        <Environment Id="MantelCADPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="MantelCADLicences" Guid="2C650C3C-06D5-52EF-A37B-FB35FF61B4C1">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="LicenseBrand" Source="$(var.BinDir)\LICENSE-BRAND" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
